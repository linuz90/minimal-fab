#!/bin/sh

set -eu

theme_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
theme_output="$theme_root/theme.css"
theme_temp=$(mktemp "$theme_root/.theme.css.XXXXXX")

cleanup() {
  rm -f "$theme_temp"
}
trap cleanup EXIT HUP INT TERM

cp "$theme_root/upstream/minimal.css" "$theme_temp"
{
printf '\n\n/* -------------------------------------------------------------------------\n'
printf '   Minimal Fab overrides\n'
printf '   ------------------------------------------------------------------------- */\n\n'
cat "$theme_root/src/fab.css"
} >> "$theme_temp"

# mktemp creates mode 0600; the generated theme is a distributable asset.
chmod 644 "$theme_temp"
mv "$theme_temp" "$theme_output"
trap - EXIT HUP INT TERM

printf 'Built %s\n' "$theme_output"
